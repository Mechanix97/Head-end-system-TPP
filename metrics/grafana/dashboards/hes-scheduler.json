          "legendFormat": "p95", "range": true, "refId": "B" },
        { "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code", "expr": "histogram_quantile(0.99, sum(rate(hes_scheduler_job_execution_duration_ms_bucket{node_id=~\"$node_id\"}[5m])) by (le))",
          "legendFormat": "p99", "range": true, "refId": "C" }
      ]
