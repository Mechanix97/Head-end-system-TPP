    {
      "type": "row", "id": 103, "title": "Session Success", "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 23 }, "panels": []
    },
    {
      "type": "timeseries", "id": 30, "title": "Session Success Rate",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "green" }, "unit": "percentunit",
          "min": 0, "max": 1,
          "custom": { "drawStyle": "line", "fillOpacity": 20, "lineWidth": 2,
            "showPoints": "never", "stacking": { "group": "A", "mode": "none" },
            "thresholdsStyle": { "mode": "line+area" } },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red", "value": null },
            { "color": "yellow", "value": 0.8 },
            { "color": "green", "value": 0.95 }
          ]}
        }, "overrides": []
      },
      "options": {
        "legend": { "calcs": ["mean", "min"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "prometheus" },
        "editorMode": "code",
        "expr": "sum(rate(hes_device_connection_outcome_total{node_id=~\"$node_id\",outcome=\"success\"}[5m])) / sum(rate(hes_device_connection_outcome_total{node_id=~\"$node_id\"}[5m]))",
        "legendFormat": "success rate", "range": true, "refId": "A" }]
    },
    {
      "type": "timeseries", "id": 31, "title": "Scheduler Job Rate",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" }, "unit": "reqps",
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 1,
            "showPoints": "never", "stacking": { "group": "A", "mode": "none" },
            "thresholdsStyle": { "mode": "off" } },
          "mappings": [], "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }]}
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "attempts" }, "properties": [{ "id": "color", "value": { "fixedColor": "blue", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "successes" }, "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }] }
        ]
      },
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code", "expr": "sum(rate(connections_tracker{node_id=~\"$node_id\",type=\"periodic_attempt\"}[5m]))",
          "legendFormat": "attempts", "range": true, "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code", "expr": "sum(rate(connections_tracker{node_id=~\"$node_id\",type=\"periodic_success\"}[5m]))",
          "legendFormat": "successes", "range": true, "refId": "B" }
      ]
