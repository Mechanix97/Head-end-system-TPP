    {
      "type": "timeseries", "id": 20, "title": "Job Execution Duration Percentiles (ms)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 15 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" }, "unit": "ms",
          "custom": { "drawStyle": "line", "fillOpacity": 0, "lineWidth": 2,
            "showPoints": "never", "stacking": { "group": "A", "mode": "none" },
            "thresholdsStyle": { "mode": "off" } },
