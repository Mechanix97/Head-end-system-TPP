  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["hes", "scheduler"],
  "templating": {
    "list": [
      {
        "current": { "selected": true, "text": ["All"], "value": ["$__all"] },
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "definition": "label_values(scheduled_devices_total, node_id)",
        "hide": 0, "includeAll": true, "multi": true, "name": "node_id",
        "options": [], "query": "label_values(scheduled_devices_total, node_id)",
        "refresh": 2, "sort": 1, "type": "query", "label": "Node"
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
