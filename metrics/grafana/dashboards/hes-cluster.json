      "pluginVersion": "11.0.0",
      "targets": [{ "datasource": { "type": "prometheus", "uid": "prometheus" },
        "editorMode": "code", "expr": "sum(hes_cluster_suspect_nodes{node_id=~\"$node_id\"})",
        "legendFormat": "", "range": true, "refId": "A" }]
