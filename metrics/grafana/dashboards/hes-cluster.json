      },
      "options": {
        "legend": { "calcs": ["sum"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "prometheus" },
        "editorMode": "code", "expr": "sum by (from, to) (rate(hes_cluster_state_changes_total{node_id=~\"$node_id\"}[5m]))",
        "legendFormat": "{{from}} → {{to}}", "range": true, "refId": "A" }]
    },
    {
      "type": "row", "id": 103, "title": "Cluster Messages", "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 23 }, "panels": []
    },
    {
      "type": "timeseries", "id": 30, "title": "Cluster Message Rate by Type",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 24 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" }, "unit": "reqps",
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 1,
            "showPoints": "never", "stacking": { "group": "A", "mode": "none" },
            "thresholdsStyle": { "mode": "off" } },
          "mappings": [], "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }]}
        }, "overrides": []
      },
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "prometheus" },
        "editorMode": "code", "expr": "sum by (msg_type, direction) (rate(hes_cluster_messages_total{node_id=~\"$node_id\"}[1m]))",
        "legendFormat": "{{msg_type}} ({{direction}})", "range": true, "refId": "A" }]
    }
