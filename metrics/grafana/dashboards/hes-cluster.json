    {
      "type": "row", "id": 101, "title": "Per-Node Load", "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 }, "panels": []
    },
    {
      "type": "timeseries", "id": 10, "title": "Devices per Node",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" }, "unit": "short",
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 1,
            "showPoints": "never", "stacking": { "group": "A", "mode": "none" },
            "thresholdsStyle": { "mode": "off" } },
          "mappings": [], "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }]}
        }, "overrides": []
      },
      "options": {
        "legend": { "calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "prometheus" },
        "editorMode": "code", "expr": "hes_cluster_node_devices{node_id=~\"$node_id\"}",
        "legendFormat": "{{node_id}}", "range": true, "refId": "A" }]
    },
    {
      "type": "timeseries", "id": 11, "title": "Buckets per Node",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" }, "unit": "short",
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 1,
